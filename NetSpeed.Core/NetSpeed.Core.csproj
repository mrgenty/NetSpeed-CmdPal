<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent speed-test logic (M-Lab Locate v2, MSAK throughput1, ndt7).
    It has no Windows or Command Palette dependency, so it builds and is unit-tested on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NetSpeed.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetSpeed.Core.Tests" />
  </ItemGroup>
</Project>
